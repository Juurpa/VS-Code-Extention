{
  "name": "pdf-workbench",
  "displayName": "PDF Workbench – PDF Editor, Redact & OCR with AI",
  "description": "Read, annotate, redact, merge, split and OCR PDFs in VS Code – offline, with the AI of your choice (Claude Code, Gemini, Ollama …).",
  "version": "0.8.1",
  "publisher": "Juurpa",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "main": "./extension.js",
  "l10n": "./l10n",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "pdfWorkbench.pdfEditor",
        "displayName": "%customEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "pdfWorkbench.setupClaudeMd",
        "title": "%cmd.setupClaudeMd.title%"
      },
      {
        "command": "pdfWorkbench.setupMcp",
        "title": "%cmd.setupMcp.title%"
      },
      {
        "command": "pdfWorkbench.revealData",
        "title": "%cmd.revealData.title%"
      },
      {
        "command": "pdfWorkbench.chooseAi",
        "title": "%cmd.chooseAi.title%"
      },
      {
        "command": "pdfWorkbench.setApiKey",
        "title": "%cmd.setApiKey.title%"
      },
      {
        "command": "pdfWorkbench.showLicenses",
        "title": "%cmd.showLicenses.title%"
      },
      {
        "command": "pdfWorkbench.reportProblem",
        "title": "%cmd.reportProblem.title%"
      },
      {
        "command": "pdfWorkbench.sendFeedback",
        "title": "%cmd.sendFeedback.title%"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "pdfWorkbench.dataFolder": {
          "type": "string",
          "default": "_pdf-workbench",
          "description": "%config.dataFolder.description%"
        },
        "pdfWorkbench.openClaudeAfterPrompt": {
          "type": "boolean",
          "default": true,
          "description": "%config.openClaudeAfterPrompt.description%"
        },
        "pdfWorkbench.ai.provider": {
          "type": "string",
          "default": "claude-code",
          "description": "%config.ai.provider.description%"
        },
        "pdfWorkbench.ai.endpoint": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "%config.ai.endpoint.description%"
        },
        "pdfWorkbench.ai.model": {
          "type": "string",
          "default": "",
          "description": "%config.ai.model.description%"
        },
        "pdfWorkbench.ai.maxChars": {
          "type": "number",
          "default": 60000,
          "description": "%config.ai.maxChars.description%"
        },
        "pdfWorkbench.feedback.githubRepo": {
          "type": "string",
          "default": "",
          "description": "%config.feedback.githubRepo.description%"
        },
        "pdfWorkbench.feedback.email": {
          "type": "string",
          "default": "",
          "description": "%config.feedback.email.description%"
        }
      }
    }
  },
  "dependencies": {
    "@hyzyla/pdfium": "^3.0.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0"
  },
  "keywords": [
    "pdf",
    "pdf editor",
    "redact",
    "ocr",
    "mcp",
    "claude",
    "documents",
    "signature"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Juurpa/VS-Code-Extention.git"
  },
  "bugs": {
    "url": "https://github.com/Juurpa/VS-Code-Extention/issues"
  },
  "homepage": "https://github.com/Juurpa/VS-Code-Extention#readme",
  "sponsor": {
    "url": "https://buymeacoffee.com/juurpa"
  }
}
